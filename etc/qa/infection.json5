{
    "timeout": 1800,
    "source": {
        "directories": [
            "../../src"
        ]
    },
    "logs": {
        "text": "../../var/infection.log",
        "summary": "../../var/infection-summary.log",
        "json": "../../var/infection.json",
        "perMutator": "../../var/infection-per-mutator.md",
        "github": true
    },
    "minMsi": 100,
    "minCoveredMsi": 100,
    "ignoreMsiWithNoMutations": true,
    "mutators": {
        "@default": true,
        "ArrayItemRemoval": {
            "ignore": [
                "WyriHaximus\\Composer\\GenerativePluginTooling\\Cache::classFilterOutcomeKey::179"
            ]
        },
        "FalseValue": {
            "ignore": [
                "WyriHaximus\\Composer\\GenerativePluginTooling\\Cache::hasCollectedItemsForClass::268",
                "WyriHaximus\\Composer\\GenerativePluginTooling\\Cache::hasFailedReflection::196"
            ]
        },
        "Identical": {
            "ignore": [
                "WyriHaximus\\Composer\\GenerativePluginTooling\\Cache::classFilePath::205"
            ]
        },
        "LogicalNot": {
            "ignore": [
                "WyriHaximus\\Composer\\GenerativePluginTooling\\Cache::classFilePath::205",
                "WyriHaximus\\Composer\\GenerativePluginTooling\\Cache::classFilterOutcome::170",
                "WyriHaximus\\Composer\\GenerativePluginTooling\\Cache::collectedItems::233",
                "WyriHaximus\\Composer\\GenerativePluginTooling\\Cache::failedReflection::185",
                "WyriHaximus\\Composer\\GenerativePluginTooling\\Cache::fileHash::135",
                "WyriHaximus\\Composer\\GenerativePluginTooling\\Cache::getClassAbsoluteFilePath::215",
                "WyriHaximus\\Composer\\GenerativePluginTooling\\Cache::hasCollectedItemsForClass::267"
            ]
        },
        "LogicalOrAllSubExprNegation": {
            "ignore": [
                "WyriHaximus\\Composer\\GenerativePluginTooling\\Cache::classFilePath::205"
            ]
        },
        "LogicalOrNegation": {
            "ignore": [
                "WyriHaximus\\Composer\\GenerativePluginTooling\\Cache::classFilePath::205"
            ]
        },
        "LogicalOr": {
            "ignore": [
                "WyriHaximus\\Composer\\GenerativePluginTooling\\Cache::classFilePath::205"
            ]
        },
        "ReturnRemoval": {
            "ignore": [
                "WyriHaximus\\Composer\\GenerativePluginTooling\\Cache::classFilePath::206",
                "WyriHaximus\\Composer\\GenerativePluginTooling\\Cache::collectedItems::234",
                "WyriHaximus\\Composer\\GenerativePluginTooling\\Cache::failedReflection::186",
                "WyriHaximus\\Composer\\GenerativePluginTooling\\Cache::fileHash::136",
                "WyriHaximus\\Composer\\GenerativePluginTooling\\Cache::getClassAbsoluteFilePath::216",
                "WyriHaximus\\Composer\\GenerativePluginTooling\\Cache::hasCollectedItemsForClass::268",
                "WyriHaximus\\Composer\\GenerativePluginTooling\\Cache::hasFailedReflection::196"
            ]
        },
        "Ternary": {
            "ignore": [
                "WyriHaximus\\Composer\\GenerativePluginTooling\\Cache::getClassFilterOutcome::163"
            ]
        }
    }
}
